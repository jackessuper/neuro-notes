# All optional. Defaults live in config.py.

# Site name; shows in the header, page titles and footer.
SITE_NAME=NeuroTips
SITE_TAGLINE=A survival guide for people getting started in neurology.
# Shown in the footer ("Made by ..."). Leave blank to omit.
SITE_AUTHOR=

# Feedback link target (footer + every page). Leave blank to hide the link.
FEEDBACK_EMAIL=

# GoatCounter site code, i.e. the <code> in https://<code>.goatcounter.com
# Leave blank to disable analytics (no script is emitted).
GOATCOUNTER_CODE=

# Public URL once deployed, no trailing slash (used for canonical + OpenGraph tags).
SITE_URL=

# Local preview port for `python3 build.py serve`
PORT=5017
